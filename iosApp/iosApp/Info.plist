<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- App is dark-only (Compose AppTheme forces dark); force native UIKit views (e.g. calf's
	     native date/time pickers) to dark too, so they don't flash a light default appearance. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>CFBundleDevelopmentRegion</key>
        <string>en</string>
        <key>CFBundleLocalizations</key>
        <array>
            <string>en</string>
            <string>ru</string>
        </array>
</dict>
</plist>
